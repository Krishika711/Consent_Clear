DANGEROUSLY_DISABLE_HOST_CHECK=true

# Local dev: leave REACT_APP_API_URL unset (uses the CRA proxy to localhost:5000).
# Production (Vercel): set to your Render backend URL, e.g.
# REACT_APP_API_URL=https://consentclear-backend.onrender.com
REACT_APP_API_URL=

# Supabase dashboard -> Settings -> API -> these are the PUBLIC values (anon key), safe for frontend
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
